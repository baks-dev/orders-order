{% if query is defined %}

    {# @var status \BaksDev\Orders\Order\Type\Status\OrderStatus #}

    {% set href = null %}

    {% if status.getOrderStatusValue == 'package' and (is_granted('ROLE_PRODUCT_STOCK_PACKAGE') or is_granted('ROLE_ADMIN')) %}
        {% set href = 'products-stocks:admin.package.index' %}
    {% elseif status.getOrderStatusValue == 'extradition' and (is_granted('ROLE_PRODUCT_STOCK_PICKUP') or is_granted('ROLE_ADMIN')) %}
        {% set href = 'products-stocks:admin.pickup.index' %}
    {% endif %}


    {% set color = status.getColor() %}

    {% if href %}
        <a
                href="{{ path(href) }}" class="w-100 badge p-2 sticky-top z-3"
                style="top: 5rem; background-color: {{ color }};"
        >
            {{ status.getOrderStatusValue|trans({}, 'status.order') }}
        </a>
    {% else %}

        <div
                class="w-100 badge p-2 sticky-top z-3 d-flex gap-3 align-items-center justify-content-center"
                style="top: 5rem; background-color: {{ color }};"
        >
            {{ status.getOrderStatusValue|trans({}, 'status.order') }}
        </div>

    {% endif %}


    {# <div class="w-100 badge p-2 sticky-top z-3 d-flex gap-3 align-items-center justify-content-center"
         style="top: 5rem; background-color: {{ color }};">
        {{ status.getOrderStatusValue()|trans({}, 'status.order') }}
    </div> #}

    {% set counter = query|length %}

    <div class="text-center">
        <small>
            {{ counter }}{{ 'num_of_orders'|trans({'count': counter}, 'messages') }}
        </small>
    </div>

    {% for order in query %}
        {# КАРТОЧКА ЗАКАЗА  #}
        {{ include(_self|replace({ "content.html.twig": "order.html.twig" })) }}
    {% endfor %}

    {% if counter %}
        <script nonce='{{ csp_nonce() }}' async data-src="/assets/{{ version }}/js/copy.min.js" class="lazy"></script>
    {% endif %}

{% endif %}


